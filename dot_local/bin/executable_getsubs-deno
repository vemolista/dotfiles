#!/usr/bin/env -S deno run --allow-run --allow-read --allow-write
import * as path from "jsr:@std/path";
import * as webvttModule from "npm:webvtt-parser";

const { WebVTTParser } = webvttModule.default;

type CookieOptions = {
  cookie?: string;
  cookiesFile?: string;
};

function cookieArgs({ cookie, cookiesFile }: CookieOptions): string[] {
  return [
    ...(cookie
      ? [
        "--add-header",
        /^\s*cookie\s*:/i.test(cookie) ? cookie : `Cookie: ${cookie}`,
      ]
      : []),
    ...(cookiesFile ? ["--cookies", cookiesFile] : []),
  ];
}

async function getVtt(
  url: string,
  arg: "--write-sub" | "--write-auto-sub",
  cookies: CookieOptions,
): Promise<null | string> {
  const tempDir = await Deno.makeTempDir();

  try {
    const cmd = new Deno.Command("yt-dlp", {
      args: [
        "--skip-download",
        arg,
        "--sub-lang",
        "en",
        "--sub-format",
        "vtt",
        "-o",
        path.join(tempDir, "%(id)s.%(ext)s"),
        ...cookieArgs(cookies),
        url,
      ],
      stdout: "piped",
      stderr: "inherit",
    });

    const { code } = await cmd.output();
    if (code !== 0) throw new Error(`yt-dlp command failed with code ${code}`);

    for await (const entry of Deno.readDir(tempDir)) {
      if (!entry.name.endsWith(".vtt")) continue;

      const vttPath = path.join(tempDir, entry.name);
      return await Deno.readTextFile(vttPath);
    }

    return null;
  } finally {
    await Deno.remove(tempDir, { recursive: true });
  }
}

type VttCue = { type: "text"; value: string } & {
  type: unknown;
  children?: VttCue[];
};

const getVttCueText = ({ children = [] }: Readonly<VttCue>): string => (
  children.reduce((result, child) => {
    if (child.type === "text") result += child.value;
    if (child.children) result += getVttCueText(child);
    return result;
  }, "")
);

function* removeConsecutiveDuplicates<T>(list: ReadonlyArray<T>): Iterable<T> {
  let previous: undefined | T;
  for (const el of list) {
    if (el !== previous) yield el;
    previous = el;
  }
}

function vttLines(vtt: string): Iterable<string> {
  const parser = new WebVTTParser();
  const tree = parser.parse(vtt, "metadata");

  let rawResult: string = "";
  for (const cue of tree.cues) {
    rawResult += getVttCueText(cue.tree).trim() + "\n";
  }

  const rawResultLines = rawResult
    .split(/\r?\n/g)
    .map((line) => line.trim().replace(/(?:\s+;)*/g, ""))
    .filter(Boolean);

  return removeConsecutiveDuplicates(rawResultLines);
}

function parseArgs(args: readonly string[]): CookieOptions & { url: string } {
  let url: string | undefined;
  let cookie: string | undefined;
  let cookiesFile: string | undefined;

  for (let i = 0; i < args.length; i++) {
    const arg = args[i];

    if (arg === "--cookie") {
      cookie = args[++i];
      if (!cookie) throw new Error("--cookie needs a value");
    } else if (arg === "--cookies") {
      cookiesFile = args[++i];
      if (!cookiesFile) throw new Error("--cookies needs a file path");
    } else if (arg.startsWith("-")) {
      throw new Error(`unknown option: ${arg}`);
    } else if (url) {
      throw new Error("too many args");
    } else {
      url = arg;
    }
  }

  if (!url) throw new Error("needs a URL");

  return { url, cookie, cookiesFile };
}

async function main(): Promise<void> {
  let options: CookieOptions & { url: string };
  try {
    options = parseArgs(Deno.args);
  } catch (error) {
    console.error(`${(error as Error).message}`);
    console.error(
      "usage: getsubs-deno <url> [--cookie '<cookie>' | --cookies <file>]",
    );
    Deno.exit(1);
  }

  const { url, ...cookies } = options;

  const vtt = await getVtt(url, "--write-sub", cookies) ||
    await getVtt(url, "--write-auto-sub", cookies);

  if (!vtt) {
    console.error("no subs found");
    Deno.exit(1);
  }

  for (const line of vttLines(vtt)) {
    console.log(line);
  }
}

await main();
